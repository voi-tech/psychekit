---
import "@/styles/global.css";

interface Props { title?: string; description?: string; noindex?: boolean }
const { title = "PsycheKit", description = "Kwestionariusze samoopisowe liczone w Twojej przeglądarce.", noindex = false } = Astro.props;

const links = [
  { href: "/", label: "Kwestionariusze" },
  { href: "/historia/", label: "Historia" },
  { href: "/licencje/", label: "Licencje" },
  { href: "/prywatnosc/", label: "Prywatność" },
  { href: "/o-projekcie/", label: "O projekcie" },
];
const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · PsycheKit</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <script is:inline src="/motyw.js"></script>
  </head>
  <body>
    <a class="pomin" href="#tresc">Przejdź do treści</a>
    <header>
      <div class="shell">
        <nav aria-label="Nawigacja główna">
          <strong><a href="/">PsycheKit</a></strong>
          {links.map((link) => (
            <a href={link.href} aria-current={(link.href.replace(/\/+$/, "") || "/") === current ? "page" : undefined}>{link.label}</a>
          ))}
          <div class="motyw">
            <label for="wybor-motywu">Wygląd</label>
            <select id="wybor-motywu">
              <option value="auto">Jak w systemie</option>
              <option value="light">Jasny</option>
              <option value="dark">Ciemny</option>
            </select>
          </div>
        </nav>
      </div>
    </header>
    <main id="tresc"><div class="shell"><slot /></div></main>
    <footer><div class="shell">Odpowiedzi są przetwarzane w Twojej przeglądarce. <a href="/prywatnosc/">Zasady prywatności</a></div></footer>
    <script is:inline src="/register-sw.js" defer></script>
  </body>
</html>
