---
import "@/styles/global.css";

interface Props { title?: string; description?: string; noindex?: boolean }
const { title = "PsycheKit", description = "Kwestionariusze samoopisowe liczone w Twojej przeglądarce.", noindex = false } = Astro.props;

const links = [
  { href: "/", label: "Kwestionariusze" },
  { href: "/historia/", label: "Historia" },
  { href: "/licencje/", label: "Licencje" },
  { href: "/prywatnosc/", label: "Prywatność" },
  { href: "/o-projekcie/", label: "O projekcie" },
];
const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · PsycheKit</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/geist-variable.woff2" crossorigin />
    <script is:inline src="/motyw.js"></script>
  </head>
  <body>
    <a class="pomin" href="#tresc">Przejdź do treści</a>
    <header class="pasek">
      <div class="shell">
        <div class="pasek-uklad">
          <a class="marka" href="/">PsycheKit</a>
          <nav class="pasek-linki" aria-label="Nawigacja główna">
            {links.map((link) => (
              <a href={link.href} aria-current={(link.href.replace(/\/+$/, "") || "/") === current ? "page" : undefined}>{link.label}</a>
            ))}
          </nav>
          <button id="przelacznik-motywu" class="btn btn-ikona przelacznik-motywu" type="button" aria-label="Wygląd: jak w systemie. Przełącz na jasny">
            {/* Ikony Lucide 1.37.0, ISC — monitor, sun, moon */}
            <svg class="ikona ikona-system" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="14" x="2" y="3" rx="2" />
              <line x1="8" x2="16" y1="21" y2="21" />
              <line x1="12" x2="12" y1="17" y2="21" />
            </svg>
            <svg class="ikona ikona-jasny" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2" />
              <path d="M12 20v2" />
              <path d="m4.93 4.93 1.41 1.41" />
              <path d="m17.66 17.66 1.41 1.41" />
              <path d="M2 12h2" />
              <path d="M20 12h2" />
              <path d="m6.34 17.66-1.41 1.41" />
              <path d="m19.07 4.93-1.41 1.41" />
            </svg>
            <svg class="ikona ikona-ciemny" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main id="tresc"><div class="shell"><slot /></div></main>
    <script is:inline src="/register-sw.js" defer></script>
  </body>
</html>
