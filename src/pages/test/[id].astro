---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TestRunner from "@/components/TestRunner";

export async function getStaticPaths() {
  const entries = await getCollection("instrumenty");
  return entries.map((entry) => ({ params: { id: entry.data.id }, props: { instrument: entry.data } }));
}

const { instrument } = Astro.props;
---
<BaseLayout title={instrument.name} description={instrument.subtitle}>
  <TestRunner client:load instrument={instrument} />
</BaseLayout>
