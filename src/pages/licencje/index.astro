---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const licenses = (await getCollection("licencje")).sort((a, b) => a.data.id.localeCompare(b.data.id, "pl"));
const instruments = await getCollection("instrumenty");

const KLASA: Record<string, string> = {
  "public-domain": "Domena publiczna",
  unrestricted: "Bez ograniczeń",
  attribution: "Wymagane wskazanie autorstwa",
  noncommercial: "Tylko użytek niekomercyjny",
  proprietary: "Prawa zastrzeżone",
};
const STATUS: Record<string, string> = { verified: "Potwierdzona", pending: "Niepotwierdzona" };
const TLUMACZENIE: Record<string, string> = {
  original: "Wersja oryginalna",
  official: "Tłumaczenie oficjalne",
  adaptation: "Adaptacja przygotowana w PsycheKit",
  none: "Brak tłumaczenia",
};
const UPRAWNIENIA: Array<[key: string, label: string]> = [
  ["redistribution", "Udostępnianie dalej"],
  ["modification", "Zmiana treści"],
  ["translation", "Tłumaczenie"],
  ["commercialUse", "Zastosowanie komercyjne"],
  ["electronicAdministration", "Wypełnianie na stronie internetowej"],
];
const JEZYK: Record<string, string> = { pl: "polska", en: "angielska" };
const tak = (value: boolean) => (value ? "Tak" : "Nie");
const data = (value: string) => new Date(value).toLocaleDateString("pl-PL");
---
<BaseLayout title="Licencje" description="Prawa do treści każdego kwestionariusza wraz ze źródłem.">
  <div class="hero">
    <h1>Prawa do treści kwestionariuszy</h1>
    <p>Każdy kwestionariusz ma osobny opis praw. Kwestionariusz, którego prawa nie zostały potwierdzone, nie jest udostępniany.</p>
  </div>

  <div class="cards">
    {licenses.map((entry) => {
      const uzywajace = instruments.filter((instrument) => instrument.data.license === entry.data.id);
      return (
        <article class="card">
          <h2>{uzywajace.length > 0 ? uzywajace.map((instrument) => instrument.data.title).join(", ") : "Nieużywane w tej wersji"}</h2>
          <dl>
            <dt>Warunki</dt><dd>{KLASA[entry.data.class]}</dd>
            <dt>Stan sprawdzenia</dt><dd>{STATUS[entry.data.status]}, sprawdzono {data(entry.data.verifiedAt)}</dd>
            <dt>Prawa do treści</dt><dd>{entry.data.holder}</dd>
            <dt>Wersja językowa</dt><dd>{entry.data.translation.type === "none" ? TLUMACZENIE.none : `${TLUMACZENIE[entry.data.translation.type]}, ${JEZYK[entry.data.translation.language] ?? entry.data.translation.language}`}</dd>
            {UPRAWNIENIA.map(([key, label]) => (
              <><dt>{label}</dt><dd>{tak(entry.data.permissions[key as keyof typeof entry.data.permissions])}</dd></>
            ))}
          </dl>
          {entry.data.attribution && <p class="meta">{entry.data.attribution}</p>}
          {entry.data.notes && <p class="meta">{entry.data.notes}</p>}
          <p><a href={entry.data.source}>Otwórz źródło</a></p>
        </article>
      );
    })}
  </div>
</BaseLayout>
